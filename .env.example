# Copia a .env y completa. Para probar: pega tu token TEMPORAL (24h) y `npm start`.
# Para produccion: pon los tokens REALES en el host (Vercel/Render/BeamUp) o
# usa /configure del addon para generar un manifest con tokens en la URL.
PORT=7000

# TMDB — al menos UNO (Bearer preferido, empieza con eyJ...):
# Consigue el "API Read Access Token" en https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
# ...o la v3 API Key como alternativa:
TMDB_API_KEY=

# Trakt — opcional, solo para catalogos "📈 Trakt":
# Crea app en https://trakt.tv/oauth/applications y pega el Client ID
TRAKT_CLIENT_ID=

# Torbox — opcional, reservado para badge ES v2 (no se usa en v0.1.0):
TORBOX_API_KEY=

# Identidad del addon (opcional):
ADDON_ID=com.tomasm.stremio-es
ADDON_NAME=Cine en Español (Privado)

# Caches en segundos (cortos a proposito: caches largos esconden fixes
# detras de respuestas viejas; a escala personal el refetch es barato):
CACHE_TTL_SEARCH=600
CACHE_TTL_CATALOG=600
CACHE_TTL_META=3600
CACHE_TTL_TRAKT=1800
